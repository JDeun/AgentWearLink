{
  "sourceLanguage": "ko",
  "strings": {
    "%@ 확인": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checked %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 확인"
          }
        }
      }
    },
    "%@에 닿지 않아요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't reach %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 닿지 않아요"
          }
        }
      }
    },
    "%@에 연결됐어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected to %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 연결됐어요"
          }
        }
      }
    },
    "%@에게서 답이 없어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No answer from %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에게서 답이 없어요"
          }
        }
      }
    },
    "%@에서 다시 승인받아야 해요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ needs to approve this device again"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 다시 승인받아야 해요"
          }
        }
      }
    },
    "%@에서 승인이 필요해요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ needs to approve this device"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 승인이 필요해요"
          }
        }
      }
    },
    "%@에서 응답이 없어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ isn't responding"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 응답이 없어요"
          }
        }
      }
    },
    "%@초": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ s"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@초"
          }
        }
      }
    },
    "1. 요청 목록을 열어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. List the requests"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 요청 목록을 열어요"
          }
        }
      }
    },
    "10분 안에 승인되지 않았어요. 다시 요청해 주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It wasn't approved within 10 minutes. Please request again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "10분 안에 승인되지 않았어요. 다시 요청해 주세요."
          }
        }
      }
    },
    "1회용 연결 코드": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One-time connection code"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1회용 연결 코드"
          }
        }
      }
    },
    "2. 지문이 %@인 요청을 승인해요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Approve the request with fingerprint %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "2. 지문이 %@인 요청을 승인해요"
          }
        }
      }
    },
    "Meta AI 앱 다시 열기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Meta AI again"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Meta AI 앱 다시 열기"
          }
        }
      }
    },
    "Meta AI 앱 열기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Meta AI"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Meta AI 앱 열기"
          }
        }
      }
    },
    "Meta AI 앱에서 Agent Wear Link를 다시 허용해 주세요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Agent Wear Link again in the Meta AI app"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Meta AI 앱에서 Agent Wear Link를 다시 허용해 주세요"
          }
        }
      }
    },
    "Meta AI 앱에서 Agent Wear Link를 허용해 주세요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Agent Wear Link in the Meta AI app"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Meta AI 앱에서 Agent Wear Link를 허용해 주세요"
          }
        }
      }
    },
    "Meta AI 앱에서 마이크를 허용해 주세요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow the microphone in the Meta AI app"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Meta AI 앱에서 마이크를 허용해 주세요"
          }
        }
      }
    },
    "Meta AI 앱에서 안경 마이크를 허용해 주세요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow the glasses microphone in the Meta AI app"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Meta AI 앱에서 안경 마이크를 허용해 주세요"
          }
        }
      }
    },
    "Meta AI 앱에서 안경을 업데이트해 주세요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update the glasses in the Meta AI app"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Meta AI 앱에서 안경을 업데이트해 주세요"
          }
        }
      }
    },
    "Meta AI 앱에서 업데이트해 주세요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update them in the Meta AI app"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Meta AI 앱에서 업데이트해 주세요"
          }
        }
      }
    },
    "Meta AI 앱에서 허용이 필요해요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs permission in the Meta AI app"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Meta AI 앱에서 허용이 필요해요"
          }
        }
      }
    },
    "Meta AI 앱에서 허용하기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow in the Meta AI app"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Meta AI 앱에서 허용하기"
          }
        }
      }
    },
    "Meta AI 앱이 열리면 Agent Wear Link를 허용해 주세요. 허용하면 이 앱으로 자동으로 돌아와요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the Meta AI app opens, allow Agent Wear Link. You'll come back here automatically."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Meta AI 앱이 열리면 Agent Wear Link를 허용해 주세요. 허용하면 이 앱으로 자동으로 돌아와요."
          }
        }
      }
    },
    "Meta 안경": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meta glasses"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Meta 안경"
          }
        }
      }
    },
    "Meta 안경 배터리가 거의 없어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meta glasses battery is almost empty"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Meta 안경 배터리가 거의 없어요"
          }
        }
      }
    },
    "Meta 안경 업데이트가 필요해요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meta glasses need an update"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Meta 안경 업데이트가 필요해요"
          }
        }
      }
    },
    "Meta 안경이 연결되지 않았어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meta glasses aren't connected"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Meta 안경이 연결되지 않았어요"
          }
        }
      }
    },
    "Meta 연결 구성을 불러오지 못했어요. Meta AI 앱이 설치되어 있는지 확인해 주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't load the Meta configuration. Check that the Meta AI app is installed."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Meta 연결 구성을 불러오지 못했어요. Meta AI 앱이 설치되어 있는지 확인해 주세요."
          }
        }
      }
    },
    "OpenClaw가 멈췄거나 컴퓨터가 잠들었을 수 있어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClaw may have stopped, or the computer may be asleep"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClaw가 멈췄거나 컴퓨터가 잠들었을 수 있어요"
          }
        }
      }
    },
    "QR 찍기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan QR"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "QR 찍기"
          }
        }
      }
    },
    "QR 한 번이면 끝, 이후 자동 연결": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One QR scan, then it reconnects by itself"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "QR 한 번이면 끝, 이후 자동 연결"
          }
        }
      }
    },
    "Tailscale 앱에서 VPN On Demand를 켜 두면 이 문제가 거의 생기지 않아요. 이 앱은 Tailscale을 직접 켤 수 없어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turning on VPN On Demand in the Tailscale app mostly prevents this. This app can't turn Tailscale on by itself."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale 앱에서 VPN On Demand를 켜 두면 이 문제가 거의 생기지 않아요. 이 앱은 Tailscale을 직접 켤 수 없어요."
          }
        }
      }
    },
    "Tailscale 앱을 열고 설정으로 가요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the Tailscale app and go to Settings"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale 앱을 열고 설정으로 가요"
          }
        }
      }
    },
    "Tailscale 열기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Tailscale"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale 열기"
          }
        }
      }
    },
    "Tailscale 항상 켜기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep Tailscale on"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale 항상 켜기"
          }
        }
      }
    },
    "Tailscale로 연결됨": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected over Tailscale"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale로 연결됨"
          }
        }
      }
    },
    "Tailscale이 꺼져 있을 수 있어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale may be off"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale이 꺼져 있을 수 있어요"
          }
        }
      }
    },
    "VPN On Demand를 켜요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on VPN On Demand"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN On Demand를 켜요"
          }
        }
      }
    },
    "Wi‑Fi나 셀룰러 연결을 확인해 주세요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your Wi‑Fi or cellular connection"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi‑Fi나 셀룰러 연결을 확인해 주세요"
          }
        }
      }
    },
    "iPhone 스피커로는 읽지 않아요. 안경이 연결되면 다음 답부터 들려요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replies are never read from the iPhone speaker. You'll hear the next one once the glasses connect."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 스피커로는 읽지 않아요. 안경이 연결되면 다음 답부터 들려요"
          }
        }
      }
    },
    "‘%@’%@ 호출 이름으로 추가": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add “%1$@” as a wake name"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’%@ 호출 이름으로 추가"
          }
        }
      }
    },
    "‘%@’, 한국어로는 어떻게 부르세요?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How do you say “%@” in Korean?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’, 한국어로는 어떻게 부르세요?"
          }
        }
      }
    },
    "‘승인 다시 받기’를 누르면 게이트웨이 컴퓨터에 새 승인 요청이 가요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap “Approve again” to send a new approval request to the gateway computer."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘승인 다시 받기’를 누르면 게이트웨이 컴퓨터에 새 승인 요청이 가요."
          }
        }
      }
    },
    "‘항상’ 또는 모든 Wi‑Fi·셀룰러에서 연결을 선택해요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose “Always”, or connect on every Wi‑Fi and cellular network"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘항상’ 또는 모든 Wi‑Fi·셀룰러에서 연결을 선택해요"
          }
        }
      }
    },
    "“%@, 안녕”": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@, hello”"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@, 안녕”"
          }
        }
      }
    },
    "게이트웨이": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gateway"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게이트웨이"
          }
        }
      }
    },
    "게이트웨이 연결하기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect the gateway"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게이트웨이 연결하기"
          }
        }
      }
    },
    "게이트웨이 이름": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gateway name"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게이트웨이 이름"
          }
        }
      }
    },
    "게이트웨이 컴퓨터가 켜져 있고 잠자기 상태가 아닌지 확인해 주세요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure the gateway computer is on and not asleep"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게이트웨이 컴퓨터가 켜져 있고 잠자기 상태가 아닌지 확인해 주세요"
          }
        }
      }
    },
    "게이트웨이 컴퓨터에 닿지 않아요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't reach the gateway computer"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게이트웨이 컴퓨터에 닿지 않아요"
          }
        }
      }
    },
    "게이트웨이 컴퓨터에서 OpenClaw가 실행 중인지 확인해 주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure OpenClaw is running on the gateway computer."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게이트웨이 컴퓨터에서 OpenClaw가 실행 중인지 확인해 주세요."
          }
        }
      }
    },
    "게이트웨이 컴퓨터에서 아래 명령으로 새 QR을 만든 뒤 다시 찍어 주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a new QR on the gateway computer with the command below, then scan it again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게이트웨이 컴퓨터에서 아래 명령으로 새 QR을 만든 뒤 다시 찍어 주세요."
          }
        }
      }
    },
    "게이트웨이 컴퓨터에서 이 기기를 승인해 주세요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve this device on the gateway computer"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게이트웨이 컴퓨터에서 이 기기를 승인해 주세요"
          }
        }
      }
    },
    "게이트웨이 컴퓨터의 QR을 찍어 주세요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan the QR from your Gateway computer"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게이트웨이 컴퓨터의 QR을 찍어 주세요"
          }
        }
      }
    },
    "게이트웨이 컴퓨터의 터미널에서": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In a terminal on the gateway computer"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게이트웨이 컴퓨터의 터미널에서"
          }
        }
      }
    },
    "게이트웨이 컴퓨터의 터미널에서 `openclaw qr`을 실행하면 주소와 1회용 코드가 담긴 QR과 설정 코드가 나와요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run `openclaw qr` in a terminal on the gateway computer. It shows a QR and a setup code with its address and a one-time code."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게이트웨이 컴퓨터의 터미널에서 `openclaw qr`을 실행하면 주소와 1회용 코드가 담긴 QR과 설정 코드가 나와요."
          }
        }
      }
    },
    "게이트웨이가 연결을 거절했어요": {
