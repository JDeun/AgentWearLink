{
  "sourceLanguage": "ko",
  "strings": {
    "%@ 연결": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 연결"
          }
        }
      }
    },
    "%@ 연결 완료": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ connected"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 연결 완료"
          }
        }
      }
    },
    "%@ 확인": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checked %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 확인"
          }
        }
      }
    },
    "%@에 닿지 않아요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't reach %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 닿지 않아요"
          }
        }
      }
    },
    "%@에 문제가 있어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has a problem"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 문제가 있어요"
          }
        }
      }
    },
    "%@에게 연결됐어요. 이후에는 자동으로 다시 연결됩니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected to %@. From now on it reconnects automatically."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에게 연결됐어요. 이후에는 자동으로 다시 연결됩니다."
          }
        }
      }
    },
    "1회용 토큰": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One-time token"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1회용 토큰"
          }
        }
      }
    },
    "Agent Wear Link": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent Wear Link"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent Wear Link"
          }
        }
      }
    },
    "Meta AI 앱 다시 열기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Meta AI again"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Meta AI 앱 다시 열기"
          }
        }
      }
    },
    "Meta AI 앱 등록 필요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Register in the Meta AI app"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Meta AI 앱 등록 필요"
          }
        }
      }
    },
    "Meta AI 앱 열기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Meta AI"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Meta AI 앱 열기"
          }
        }
      }
    },
    "Meta AI 앱에서 Agent Wear Link를 허용해 주세요. 허용하면 이 앱으로 자동으로 돌아옵니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Agent Wear Link in the Meta AI app. You'll come back here automatically."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Meta AI 앱에서 Agent Wear Link를 허용해 주세요. 허용하면 이 앱으로 자동으로 돌아옵니다."
          }
        }
      }
    },
    "Meta AI 앱에서 등록하기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Register in Meta AI"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Meta AI 앱에서 등록하기"
          }
        }
      }
    },
    "Meta AI 앱에서 안경 마이크를 허용하지 않음": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The glasses microphone isn't allowed in Meta AI"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Meta AI 앱에서 안경 마이크를 허용하지 않음"
          }
        }
      }
    },
    "Meta AI 앱에서 안경 업데이트가 필요함": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The glasses need an update in Meta AI"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Meta AI 앱에서 안경 업데이트가 필요함"
          }
        }
      }
    },
    "Meta AI 앱에서 이 앱 연결이 해제됨": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app was disconnected in Meta AI"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Meta AI 앱에서 이 앱 연결이 해제됨"
          }
        }
      }
    },
    "Meta AI 앱에서 허용": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow in the Meta AI app"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Meta AI 앱에서 허용"
          }
        }
      }
    },
    "Meta 연결 구성을 불러오지 못했어요. Meta AI 앱이 설치되어 있는지 확인해 주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't load the Meta configuration. Check that the Meta AI app is installed."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Meta 연결 구성을 불러오지 못했어요. Meta AI 앱이 설치되어 있는지 확인해 주세요."
          }
        }
      }
    },
    "OpenClaw 게이트웨이 · 이 기기 승인됨": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClaw Gateway · this device approved"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClaw 게이트웨이 · 이 기기 승인됨"
          }
        }
      }
    },
    "OpenClaw 게이트웨이가 멈춤": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The OpenClaw Gateway stopped"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClaw 게이트웨이가 멈춤"
          }
        }
      }
    },
    "OpenClaw 게이트웨이에서 새 기기 요청을 승인해 주세요. 요청의 기기 지문이 아래와 같은지 확인하세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve the new device request on the OpenClaw Gateway. Check that its fingerprint matches the one below."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenClaw 게이트웨이에서 새 기기 요청을 승인해 주세요. 요청의 기기 지문이 아래와 같은지 확인하세요."
          }
        }
      }
    },
    "QR 찍기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan QR"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "QR 찍기"
          }
        }
      }
    },
    "QR 한 번이면 끝, 이후 자동 재연결": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One QR scan, then automatic reconnects"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "QR 한 번이면 끝, 이후 자동 재연결"
          }
        }
      }
    },
    "Tailscale 앱 설정에서 VPN On Demand를 켜 두면 이 문제가 거의 생기지 않아요. 이 앱은 Tailscale 상태를 직접 확인하거나 켤 수 없어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turning on VPN On Demand in the Tailscale app settings mostly prevents this. This app can't check or turn on Tailscale itself."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale 앱 설정에서 VPN On Demand를 켜 두면 이 문제가 거의 생기지 않아요. 이 앱은 Tailscale 상태를 직접 확인하거나 켤 수 없어요."
          }
        }
      }
    },
    "Tailscale 앱을 열고 설정으로 이동": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the Tailscale app and go to Settings"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale 앱을 열고 설정으로 이동"
          }
        }
      }
    },
    "Tailscale 자동 연결": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale always on"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale 자동 연결"
          }
        }
      }
    },
    "Tailscale로 게이트웨이 응답": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gateway answers over Tailscale"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale로 게이트웨이 응답"
          }
        }
      }
    },
    "Tailscale을 항상 연결해 두세요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep Tailscale connected"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale을 항상 연결해 두세요"
          }
        }
      }
    },
    "VPN On Demand를 켜기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on VPN On Demand"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN On Demand를 켜기"
          }
        }
      }
    },
    "VPN On Demand를 켜서 항상 연결": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN On Demand keeps it connected"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN On Demand를 켜서 항상 연결"
          }
        }
      }
    },
    "‘항상 연결’ 또는 모든 Wi‑Fi·셀룰러에서 연결 선택": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose “Always” or connect on every Wi‑Fi and cellular network"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘항상 연결’ 또는 모든 Wi‑Fi·셀룰러에서 연결 선택"
          }
        }
      }
    },
    "게이트웨이": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gateway"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게이트웨이"
          }
        }
      }
    },
    "게이트웨이 연결": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect the Gateway"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게이트웨이 연결"
          }
        }
      }
    },
    "게이트웨이 이름": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gateway name"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게이트웨이 이름"
          }
        }
      }
    },
    "게이트웨이 컴퓨터가 꺼졌거나 잠듦": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Gateway computer is off or asleep"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게이트웨이 컴퓨터가 꺼졌거나 잠듦"
          }
        }
      }
    },
    "게이트웨이 컴퓨터에서 openclaw qr을 실행하면 주소와 1회용 연결 코드가 담긴 QR이 나와요. 토큰을 직접 입력할 필요가 없어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run openclaw qr on the Gateway computer to show a QR with its address and a one-time code. No need to type a token."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게이트웨이 컴퓨터에서 openclaw qr을 실행하면 주소와 1회용 연결 코드가 담긴 QR이 나와요. 토큰을 직접 입력할 필요가 없어요."
          }
        }
      }
    },
    "게이트웨이 컴퓨터의 QR을 찍어 주세요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan the QR from your Gateway computer"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게이트웨이 컴퓨터의 QR을 찍어 주세요"
          }
        }
      }
    },
    "게이트웨이가 연결을 거절했어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Gateway refused the connection."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게이트웨이가 연결을 거절했어요."
          }
        }
      }
    },
    "게이트웨이가 응답하지 않음": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Gateway isn't responding"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게이트웨이가 응답하지 않음"
          }
        }
      }
    },
    "게이트웨이까지 닿지 않음": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't reach the Gateway"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게이트웨이까지 닿지 않음"
          }
        }
      }
    },
    "게이트웨이에 닿지 않아요. Tailscale이 켜져 있는지 확인해 주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't reach the Gateway. Check that Tailscale is on."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게이트웨이에 닿지 않아요. Tailscale이 켜져 있는지 확인해 주세요."
          }
        }
      }
    },
    "게이트웨이에 연결하는 중": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecting to the Gateway"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게이트웨이에 연결하는 중"
          }
        }
      }
    },
    "게이트웨이에서 승인 대기 중": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for approval on the Gateway"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게이트웨이에서 승인 대기 중"
          }
        }
      }
    },
    "게이트웨이에서 승인을 기다리는 중": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for approval on the Gateway"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게이트웨이에서 승인을 기다리는 중"
          }
        }
      }
    },
    "게이트웨이에서 이 기기 승인을 아직 하지 않음": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device hasn't been approved on the Gateway yet"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게이트웨이에서 이 기기 승인을 아직 하지 않음"
          }
        }
      }
    },
    "게이트웨이에서 이 기기 승인이 취소됨": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device's approval was revoked on the Gateway"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게이트웨이에서 이 기기 승인이 취소됨"
          }
        }
      }
    },
    "기기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기"
          }
        }
      }
    },
    "기본값으로": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset to default"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본값으로"
          }
        }
      }
    },
    "긴 답이 안경에서 끝까지 읽힙니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Long answers are read out in full on the glasses"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "긴 답이 안경에서 끝까지 읽힙니다"
          }
        }
      }
    },
    "끄면 대화가 어디에도 남지 않습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When off, conversations aren't recorded anywhere"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄면 대화가 어디에도 남지 않습니다"
          }
        }
      }
    },
    "끊김": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Broken"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끊김"
