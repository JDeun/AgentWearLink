    },
    "음성 인식이 시작되지 않음": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech recognition didn't start"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 인식이 시작되지 않음"
          }
        }
      }
    },
    "응답함": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answered"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "응답함"
          }
        }
      }
    },
    "이 iPhone": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPhone"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone"
          }
        }
      }
    },
    "이 iPhone 설정이 필요해요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPhone needs a setting"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone 설정이 필요해요"
          }
        }
      }
    },
    "이 iPhone의 Tailscale이 꺼짐 — Tailscale 앱에서 켜 주세요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale is off on this iPhone — turn it on in the Tailscale app"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone의 Tailscale이 꺼짐 — Tailscale 앱에서 켜 주세요"
          }
        }
      }
    },
    "이 기기 승인이 필요함": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device needs approval"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기 승인이 필요함"
          }
        }
      }
    },
    "이 기기 지문": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device fingerprint"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기 지문"
          }
        }
      }
    },
    "이 기기에서 카메라를 쓸 수 없어요. 코드를 붙여넣거나 주소를 직접 입력해 주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera isn't available on this device. Paste the code or enter the address."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 카메라를 쓸 수 없어요. 코드를 붙여넣거나 주소를 직접 입력해 주세요."
          }
        }
      }
    },
    "이 기기의 저장된 승인을 지우고 게이트웨이 연결 단계로 돌아갑니다. 다른 설정은 그대로입니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes this device's stored approval and returns to the Gateway step. Other settings stay."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기의 저장된 승인을 지우고 게이트웨이 연결 단계로 돌아갑니다. 다른 설정은 그대로입니다."
          }
        }
      }
    },
    "이 빌드에는 Meta 등록 정보(Team ID, 콜백 스킴)가 없어요. local.companion.xcconfig를 채운 뒤 다시 빌드해 주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This build has no Meta registration details (Team ID, callback scheme). Fill in local.companion.xcconfig and rebuild."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 빌드에는 Meta 등록 정보(Team ID, 콜백 스킴)가 없어요. local.companion.xcconfig를 채운 뒤 다시 빌드해 주세요."
          }
        }
      }
    },
    "이 앱은 Tailscale 상태를 직접 확인하거나 켤 수 없어요. 연결이 끊기면 원인 후보와 다시 확인 버튼을 보여 드려요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app can't check or turn on Tailscale. If the connection drops, it shows likely causes and a Check again button."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱은 Tailscale 상태를 직접 확인하거나 켤 수 없어요. 연결이 끊기면 원인 후보와 다시 확인 버튼을 보여 드려요."
          }
        }
      }
    },
    "이런 경우가 많아요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Common causes"
          }
        },
        "ko": {
          "stringUnit": {
