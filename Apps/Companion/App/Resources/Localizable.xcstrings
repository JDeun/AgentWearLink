    "연결 방법": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection method"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결 방법"
          }
        }
      }
    },
    "연결 상태 기록만 담깁니다. 토큰과 말한 내용은 기록하지 않습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contains connection events only. Tokens and what you said are never logged."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결 상태 기록만 담깁니다. 토큰과 말한 내용은 기록하지 않습니다."
          }
        }
      }
    },
    "연결 상태를 확인하고 있어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking the connection"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결 상태를 확인하고 있어요"
          }
        }
      }
    },
    "연결됨": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결됨"
          }
        }
      }
    },
    "연결됨 · 배터리 %lld%%": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected · battery %lld%%"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결됨 · 배터리 %lld%%"
          }
        }
      }
    },
    "연결하면 게이트웨이에 승인 요청이 가요. 승인할 때 이 기기 지문 %@이 맞는지 확인하세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecting sends an approval request to the Gateway. When approving, check that the device fingerprint is %@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결하면 게이트웨이에 승인 요청이 가요. 승인할 때 이 기기 지문 %@이 맞는지 확인하세요."
          }
        }
      }
    },
    "완료": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료"
          }
        }
